<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحدي مبرمجات المستقبل 👑💻</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: radial-gradient(circle at top right, #1e1b4b 0%, #0f172a 60%, #090d16 100%);
            min-height: 100vh;
            color: #f8fafc;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .glass-option {
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-option:hover:not(:disabled) {
            background: rgba(236, 72, 153, 0.15);
            border-color: rgba(244, 114, 182, 0.5);
            transform: translateY(-2px);
        }

        .glass-option.selected-correct {
            background: rgba(16, 185, 129, 0.25) !important;
            border-color: #10b981 !important;
            color: #a7f3d0 !important;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
        }

        .glass-option.selected-wrong {
            background: rgba(239, 68, 68, 0.25) !important;
            border-color: #ef4444 !important;
            color: #fca5a5 !important;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
        }

        .gold-text {
            background: linear-gradient(135deg, #fef08a 0%, #f59e0b 50%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .pink-text {
            background: linear-gradient(135deg, #f472b6 0%, #ec4899 50%, #db2777 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .crown-glow {
            filter: drop-shadow(0 0 15px rgba(245, 158, 11, 0.6));
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
        }

        .floating {
            animation: float 4s ease-in-out infinite;
        }

        @media print {
            body {
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            .certificate-box {
                border: 4px solid #d97706 !important;
                background: #fff8f0 !important;
                color: #000 !important;
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body class="p-3 md:p-6 flex flex-col justify-between min-h-screen relative overflow-x-hidden">

    <!-- Background Particle Canvas -->
    <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

    <header class="relative z-10 max-w-4xl mx-auto w-full mb-4 no-print">
        <div class="glass-card rounded-2xl p-4 flex justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center text-xl md:text-2xl shadow-lg">
                    <i class="fa-solid fa-crown text-amber-300"></i>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-black gold-text tracking-wide">تحدي مبرمجات المستقبل 💎</h1>
                    <p class="text-[11px] md:text-xs text-purple-200">المهارات الرقمية - الصف الثالث المتوسط</p>
                    <p class="text-[10px] md:text-[11px] text-amber-300 font-bold">إعداد: أ. غادة العتيبي 🌸</p>
                </div>
            </div>

            <button onclick="toggleSound()" id="sound-btn" class="glass-card px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-2 hover:bg-white/10 transition">
                <i class="fa-solid fa-volume-high text-pink-400" id="sound-icon"></i>
                <span id="sound-status" class="hidden sm:inline">الصوت مفعّل</span>
            </button>
        </div>
    </header>

    <main class="relative z-10 max-w-3xl mx-auto w-full flex-grow flex flex-col justify-center my-2">

        <section id="start-screen" class="w-full">
            <div class="glass-card rounded-3xl p-6 sm:p-10 text-center space-y-6 relative overflow-hidden border-pink-500/30">
                <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-amber-400 to-pink-500 p-1 mx-auto shadow-2xl floating">
                    <div class="w-full h-full bg-slate-950 rounded-full flex items-center justify-center text-4xl">
                        👑
                    </div>
                </div>

                <div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white">أهلاً بكِ في تحدي مبرمجات المستقبل! 🌸</h2>
                    <p class="text-sm text-slate-300 mt-2 leading-relaxed">
                        أجيبي عن أسئلة درس **إنشاء قواعد البيانات** واكتشفي اللقب الملكي الذي تستحقينه اليوم!
                    </p>
                </div>

                <!-- Titles Preview Box -->
                <div class="p-4 bg-purple-950/40 rounded-2xl border border-purple-500/20 text-xs text-slate-200 text-right space-y-2">
                    <div class="font-bold text-amber-300 text-sm mb-2 text-center">🏆 الألقاب المستهدفة في التحدي:</div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-center">
                        <div class="bg-amber-500/10 p-2 rounded-xl border border-amber-400/30">
                            <span class="block text-lg">👑</span>
                            <span class="font-bold text-amber-300">ملكة البيانات</span>
                            <span class="block text-[10px] text-slate-400">للدرجة الكاملة (100%)</span>
                        </div>
                        <div class="bg-pink-500/10 p-2 rounded-xl border border-pink-400/30">
                            <span class="block text-lg">👸</span>
                            <span class="font-bold text-pink-300">أميرة البيانات</span>
                            <span class="block text-[10px] text-slate-400">للدرجات (80% - 90%)</span>
                        </div>
                        <div class="bg-purple-500/10 p-2 rounded-xl border border-purple-400/30">
                            <span class="block text-lg">🌟</span>
                            <span class="font-bold text-purple-300">نجمة البيانات</span>
                            <span class="block text-[10px] text-slate-400">للدرجات (60% - 70%)</span>
                        </div>
                    </div>
                </div>

                <!-- Inputs Form -->
                <div class="space-y-3 max-w-md mx-auto text-right">
                    <div>
                        <label class="text-xs font-bold text-pink-300 mb-1 block mr-1">اسم الطالبة الثلاثي:</label>
                        <input type="text" id="student-name" placeholder="اكتبي اسمكِ هنا..." 
                            class="w-full bg-slate-900/80 border border-purple-500/40 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-pink-500 font-bold text-base transition">
                    </div>
                </div>

                <button onclick="startQuiz()" class="w-full max-w-md mx-auto py-4 bg-gradient-to-r from-amber-400 via-pink-500 to-purple-600 text-slate-950 font-black text-lg rounded-2xl shadow-xl hover:scale-105 transition duration-300 flex items-center justify-center gap-2">
                    <span>انطلقي للتحدي الآن</span>
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
            </div>
        </section>

        <section id="quiz-screen" class="hidden w-full">
            <div class="glass-card rounded-3xl p-5 sm:p-8 space-y-6 relative border-purple-500/30">
                
                <!-- Status & Progress Bar Header -->
                <div class="space-y-2">
                    <div class="flex justify-between items-center text-xs font-bold">
                        <span id="question-progress-text" class="text-pink-300 bg-pink-500/20 px-3 py-1 rounded-full border border-pink-500/30">
                            السؤال 1 من 5
                        </span>
                        <div class="flex items-center gap-2 text-amber-300 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20">
                            <i class="fa-solid fa-star"></i>
                            <span id="live-score">النقاط: 0</span>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="w-full h-2.5 bg-slate-900 rounded-full overflow-hidden border border-white/10">
                        <div id="progress-bar-fill" class="h-full bg-gradient-to-r from-pink-500 to-amber-400 transition-all duration-300" style="width: 20%;"></div>
                    </div>
                </div>

                <!-- Active Question Box -->
                <div class="space-y-4 my-4">
                    <div class="flex items-center gap-2 text-xs font-bold text-purple-300">
                        <i class="fa-solid fa-circle-question text-pink-400"></i>
                        <span id="question-category">المفهوم والأساسيات</span>
                    </div>

                    <h3 id="question-text" class="text-lg sm:text-xl font-extrabold text-white leading-relaxed min-h-[60px]">
                        جاري تحميل السؤال...
                    </h3>
                </div>

                <!-- Answer Options Matrix -->
                <div id="options-container" class="grid grid-cols-1 gap-3">
                    <!-- Dynamic option buttons generated via JS -->
                </div>

                <!-- Explanation Feedback Bar -->
                <div id="feedback-box" class="hidden p-4 rounded-2xl text-xs sm:text-sm font-bold border transition-all animate-fade-in">
                    <div id="feedback-title" class="font-extrabold text-base mb-1"></div>
                    <div id="feedback-desc" class="text-slate-200 font-normal leading-relaxed"></div>
                </div>

                <!-- Next Button Container -->
                <div class="flex justify-end pt-2">
                    <button onclick="nextQuestion()" id="next-btn" disabled class="px-8 py-3 bg-gradient-to-r from-pink-500 to-purple-600 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold rounded-xl shadow-lg hover:scale-105 transition flex items-center gap-2">
                        <span>السؤال التالي</span>
                        <i class="fa-solid fa-arrow-left text-xs"></i>
                    </button>
                </div>

            </div>
        </section>

        <section id="result-screen" class="hidden w-full">
            <div class="glass-card certificate-box rounded-3xl p-6 sm:p-10 text-center space-y-6 relative overflow-hidden border-amber-400/50 shadow-2xl">
                
                <!-- Background Glow Elements -->
                <div class="absolute -top-12 -right-12 w-40 h-40 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-12 -left-12 w-40 h-40 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <!-- Title Crown Badge Icon -->
                <div class="relative inline-block my-2">
                    <div id="final-badge-icon" class="w-28 h-28 rounded-full bg-gradient-to-tr from-amber-400 via-pink-500 to-purple-600 p-1 mx-auto shadow-2xl flex items-center justify-center text-6xl floating crown-glow">
                        👑
                    </div>
                </div>

                <div>
                    <span class="text-xs text-amber-300 font-extrabold tracking-widest uppercase bg-amber-400/10 px-4 py-1.5 rounded-full border border-amber-400/20">
                        نتيجة التحدي وإحراز اللقب 🏆
                    </span>
                    
                    <h2 id="final-title-name" class="text-3xl sm:text-4xl font-black mt-3 gold-text">
                        ملكة البيانات 👑
                    </h2>
                    
                    <p class="text-base text-slate-200 mt-2 font-bold">
                        مبارك للطالبة المتميزة: <span id="res-student-name" class="text-pink-300 underline font-black">---</span>
                    </p>
                    <p class="text-xs text-amber-300 font-bold mt-1">إعداد المعلمة: أ. غادة العتيبي 🌸</p>
                </div>

                <!-- Stats Cards Grid -->
                <div class="grid grid-cols-3 gap-3 max-w-md mx-auto my-4 text-center">
                    <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                        <span class="block text-xs text-slate-400 mb-1">الدرجة المكتسبة</span>
                        <span id="res-score" class="text-xl font-black text-amber-300">100%</span>
                    </div>
                    <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                        <span class="block text-xs text-slate-400 mb-1">الإجابات الصحيحة</span>
                        <span id="res-correct-count" class="text-xl font-black text-emerald-400">5/5</span>
                    </div>
                    <div class="p-3 bg-white/5 rounded-2xl border border-white/10">
                        <span class="block text-xs text-slate-400 mb-1">التقييم</span>
                        <span id="res-rating" class="text-xl font-black text-pink-400">ممتاز 🌟</span>
                    </div>
                </div>

                <!-- Title Encouragement Message -->
                <p id="final-message" class="text-xs sm:text-sm text-slate-300 max-w-lg mx-auto leading-relaxed bg-purple-900/30 p-4 rounded-2xl border border-purple-500/20">
                    أداء استثنائي ومبهر! أثبتِ جدارتكِ الفائقة في فهم وإتقان مفاهيم قواعد البيانات ومكوناتها.
                </p>

                <!-- Actions Buttons (No-Print) -->
                <div class="flex flex-wrap justify-center gap-3 pt-4 border-t border-white/10 no-print">
                    <button onclick="window.print()" class="px-6 py-3 bg-purple-600/30 hover:bg-purple-600/50 text-purple-200 border border-purple-500/30 font-bold rounded-xl transition flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-print"></i>
                        <span>طباعة الشهادة / حفظ PDF</span>
                    </button>
                    <button onclick="restartQuiz()" class="px-8 py-3 bg-gradient-to-r from-pink-500 to-purple-600 text-white font-bold rounded-xl shadow-lg hover:scale-105 transition flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>إعادة التحدي</span>
                    </button>
                </div>

            </div>
        </section>

    </main>

    <footer class="relative z-10 text-center py-3 text-xs text-slate-300 no-print space-y-1">
        <p>نشاط فردي تقييمي مخصص لمادة المهارات الرقمية - الصف الثالث المتوسط 💾</p>
        <p class="font-bold text-amber-300">إعداد المعلمة: أ. غادة العتيبي 🌸</p>
    </footer>

    <script>
        const quizQuestions = [
            {
                id: 1,
                category: "مفهوم قاعدة البيانات",
                question: "ما التعريف الدقيق والأصح لقاعدة البيانات (Database)؟",
                options: [
                    "مجموعة من البيانات المنظمة والمرتبطة ببعضها والتي يمكن استرجاعها وتعديلها بسهولة",
                    "ملف مستند نصي عالي الجودة يُكتب على برنامج Word",
                    "برنامج حاسوبي مخصص لتجميع مقاطع الفيديو والصور",
                    "جهاز تخزين خارجي يُوصل بالحاسب للحفظ الاحتياطي"
                ],
                correct: 0,
                explanation: "قاعدة البيانات هي مجموعة منظمة من البيانات المرتبطة منطقياً ببعضها، مما يسهل البحث فيها وإدارتها."
            },
            {
                id: 2,
                category: "مكونات الجدول",
                question: "في جدول قاعدة البيانات، ماذا يُسمى العمود الرأسي الذي يحدد خاصية واحدة محددة؟",
                options: [
                    "السجل (Record)",
                    "الحقل (Field)",
                    "المفتاح الأساسي (Primary Key)",
                    "الاستعلام (Query)"
                ],
                correct: 1,
                explanation: "الحقل (Field) هو العمود الرأسي في الجدول، ويختص بنوع واحد من البيانات مثل (اسم الطالبة) أو (رقم الهاتف)."
            },
            {
                id: 3,
                category: "مكونات الجدول",
                question: "الصف الأفقي الكامل في الجدول والذي يضم جميع البيانات الخاصة بطالبة واحدة يُسمى:",
                options: [
                    "الحقل (Field)",
                    "السجل (Record)",
                    "قاعدة البيانات (Database)",
                    "نظام إدارة القواعد (DBMS)"
                ],
                correct: 1,
                explanation: "السجل (Record) يمثل الصف الأفقي الكامل الذي يحتوي على كافة المعلومات المتعلقة بكيان أو عنصر واحد."
            },
            {
                id: 4,
                category: "المفتاح الأساسي",
                question: "ما الميزة الفريدة التي تميز (المفتاح الأساسي Primary Key) عن باقي الحقول؟",
                options: [
                    "قيمته فريدة لا تتكرر إطلاقاً ولا يمكن أن تترك فارغة (Null)",
                    "يحتوي دائماً على نصوص طويلة جداً",
                    "يتغير قيمته تلقائياً كل يوم",
                    "يمكن تكرار قيمته لجميع الطالبات بشكل عشوائي"
                ],
                correct: 0,
                explanation: "المفتاح الأساسي يُستخدم لتمييز كل سجل بشكل فريد ومطلق (مثل رقم الهوية أو رقم الطالبة) ولا يتكرر."
            },
            {
                id: 5,
                category: "نظم إدارة قواعد البيانات",
                question: "ما الاختصار العالمي الشهير لـ (نظام إدارة قواعد البيانات)؟",
                options: [
                    "HTML",
                    "DBMS",
                    "HTTP",
                    "RAM"
                ],
                correct: 1,
                explanation: "DBMS اختصار لـ Database Management System وهي البرامج المسؤولة عن بناء وتطوير وإدارة قواعد البيانات."
            }
        ];

        let currentQuestionIdx = 0;
        let score = 0;
        let soundEnabled = true;
        let studentInfo = { name: "" };
        let answered = false;

        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) audioCtx = new AudioCtx();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(500, now);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'correct') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.1);
                    osc.frequency.setValueAtTime(783.99, now + 0.2);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.setValueAtTime(180, now + 0.12);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'fanfare') {
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.frequency.setValueAtTime(freq, now + idx * 0.12);
                        g.gain.setValueAtTime(0.15, now + idx * 0.12);
                        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.12 + 0.3);
                        o.start(now + idx * 0.12);
                        o.stop(now + idx * 0.12 + 0.3);
                    });
                }
            } catch (e) {
                console.log("Audio Exception", e);
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('sound-status').innerText = soundEnabled ? 'الصوت مفعّل' : 'الصوت مكتوم';
            document.getElementById('sound-icon').className = soundEnabled ? 'fa-solid fa-volume-high text-pink-400' : 'fa-solid fa-volume-xmark text-slate-500';
        }

        function startQuiz() {
            const nameInput = document.getElementById('student-name').value.trim();

            if (!nameInput) {
                alert("لطفاً اكتبي اسمكِ أولاً للبدء بالحصول على اللقب 🌸");
                return;
            }

            studentInfo.name = nameInput;

            playSound('click');

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');

            currentQuestionIdx = 0;
            score = 0;
            loadQuestion();
        }

        function loadQuestion() {
            answered = false;
            const q = quizQuestions[currentQuestionIdx];

            const progressPercent = ((currentQuestionIdx + 1) / quizQuestions.length) * 100;
            document.getElementById('progress-bar-fill').style.width = `${progressPercent}%`;
            document.getElementById('question-progress-text').innerText = `السؤال ${currentQuestionIdx + 1} من ${quizQuestions.length}`;
            document.getElementById('live-score').innerText = `النقاط: ${score}`;

            document.getElementById('question-category').innerText = q.category;
            document.getElementById('question-text').innerText = q.question;

            const feedbackBox = document.getElementById('feedback-box');
            feedbackBox.className = "hidden p-4 rounded-2xl text-xs sm:text-sm font-bold border transition-all animate-fade-in";

            const container = document.getElementById('options-container');
            container.innerHTML = q.options.map((opt, i) => `
                <button onclick="handleSelectOption(${i})" class="glass-option option-btn w-full text-right p-4 rounded-2xl text-white font-medium text-sm flex items-center justify-between group">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-white/10 text-pink-300 font-bold text-xs flex items-center justify-center group-hover:bg-pink-500 group-hover:text-white transition">
                            ${['أ', 'ب', 'ج', 'د'][i]}
                        </span>
                        <span>${opt}</span>
                    </div>
                    <i class="fa-regular fa-circle option-check-icon text-slate-500"></i>
                </button>
            `).join('');

            document.getElementById('next-btn').disabled = true;
        }

        function handleSelectOption(optIdx) {
            if (answered) return;
            answered = true;

            const q = quizQuestions[currentQuestionIdx];
            const isCorrect = optIdx === q.correct;
            const optionBtns = document.querySelectorAll('.option-btn');
            const feedbackBox = document.getElementById('feedback-box');
            const feedbackTitle = document.getElementById('feedback-title');
            const feedbackDesc = document.getElementById('feedback-desc');

            optionBtns.forEach((btn, idx) => {
                btn.disabled = true;
                const icon = btn.querySelector('.option-check-icon');

                if (idx === q.correct) {
                    btn.classList.add('selected-correct');
                    icon.className = "fa-solid fa-circle-check text-emerald-400 text-base";
                } else if (idx === optIdx && !isCorrect) {
                    btn.classList.add('selected-wrong');
                    icon.className = "fa-solid fa-circle-xmark text-red-400 text-base";
                }
            });

            if (isCorrect) {
                score += 10;
                playSound('correct');
                feedbackBox.className = "p-4 rounded-2xl text-xs sm:text-sm font-bold border bg-emerald-500/15 border-emerald-500/30 text-emerald-300 animate-fade-in";
                feedbackTitle.innerText = "إجابة صحيحة وممتازة! ✨";
            } else {
                playSound('wrong');
                feedbackBox.className = "p-4 rounded-2xl text-xs sm:text-sm font-bold border bg-red-500/15 border-red-500/30 text-red-300 animate-fade-in";
                feedbackTitle.innerText = "إجابة خاطئة!";
            }

            feedbackDesc.innerText = q.explanation;
            feedbackBox.classList.remove('hidden');

            document.getElementById('live-score').innerText = `النقاط: ${score}`;
            document.getElementById('next-btn').disabled = false;
        }

        function nextQuestion() {
            playSound('click');
            currentQuestionIdx++;

            if (currentQuestionIdx < quizQuestions.length) {
                loadQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const totalScorePossible = quizQuestions.length * 10;
            const percentage = Math.round((score / totalScorePossible) * 100);
            const correctCount = score / 10;

            document.getElementById('res-student-name').innerText = studentInfo.name;
            document.getElementById('res-score').innerText = `${percentage}%`;
            document.getElementById('res-correct-count').innerText = `${correctCount}/${quizQuestions.length}`;

            let titleName = "";
            let titleBadge = "";
            let message = "";
            let rating = "";

            if (percentage === 100) {
                titleName = "ملكة البيانات 👑";
                titleBadge = "👑";
                rating = "استثنائي 👑";
                message = "مبارك! حصلتِ على اللقب الأعلى (ملكة البيانات)! أظهرتِ استيعاباً كاملاً وبراعة فائقة في جميع عناصر ومفاهيم الدرس.";
                triggerConfetti();
                playSound('fanfare');
            } else if (percentage >= 80) {
                titleName = "أميرة البيانات 👸";
                titleBadge = "👸";
                rating = "ممتاز جداً 🌟";
                message = "رائع جداً! استحققتِ بجدارة لقب (أميرة البيانات) بفضل مجموعتك الممتازة من الإجابات الصحيحة والتفوق الواضح.";
                triggerConfetti();
                playSound('fanfare');
            } else if (percentage >= 60) {
                titleName = "نجمة البيانات 🌟";
                titleBadge = "🌟";
                rating = "جيد جداً ✨";
                message = "أحسنتِ! حصلتِ على لقب (نجمة البيانات). أداء طيب يدل على فهمك الأساسي لمكونات ونظم قواعد البيانات.";
                playSound('correct');
            } else {
                titleName = "مبدعة البيانات 🌸";
                titleBadge = "🌸";
                rating = "محاولة جيدة 🌸";
                message = "جهد مشكور! حصلتِ على لقب (مبدعة البيانات). يمكنكِ مراجعة ملخص الدرس وإعادة التحدي للوصول للقب الملكة!";
                playSound('correct');
            }

            document.getElementById('final-title-name').innerText = titleName;
            document.getElementById('final-badge-icon').innerText = titleBadge;
            document.getElementById('res-rating').innerText = rating;
            document.getElementById('final-message').innerText = message;
        }

        function restartQuiz() {
            playSound('click');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }

        function triggerConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const colors = ['#f59e0b', '#ec4899', '#8b5cf6', '#10b981', '#3b82f6'];

            for (let i = 0; i < 120; i++) {
                particles.push({
                    x: canvas.width / 2,
                    y: canvas.height / 2,
                    vx: (Math.random() - 0.5) * 14,
                    vy: (Math.random() - 0.5) * 14 - 3,
                    size: Math.random() * 8 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    alpha: 1,
                    rotation: Math.random() * 360
                });
            }

            let animationFrame;
            function render() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let alive = false;

                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.2;
                    p.alpha -= 0.008;

                    if (p.alpha > 0) {
                        alive = true;
                        ctx.save();
                        ctx.globalAlpha = p.alpha;
                        ctx.translate(p.x, p.y);
                        ctx.rotate((p.rotation * Math.PI) / 180);
                        ctx.fillStyle = p.color;
                        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
                        ctx.restore();
                    }
                });

                if (alive) {
                    animationFrame = requestAnimationFrame(render);
                } else {
                    cancelAnimationFrame(animationFrame);
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            }

            render();
        }
    </script>
</body>
